#!/bin/sh
#
# The push hook for the public repository.
#
# There are two repositories and only one of them can push. The working one
# holds the records and has no remote, so hooks/pre-push, which was written
# for it, guards a repository that never hands anything to anybody. The public
# one is where a push actually reaches strangers, and every check in that hook
# fails there by construction: it verifies records that are correctly absent,
# and it recompiles a register that cannot be recompiled without them.
#
# So the guard was installed in neither. It could not run where it was needed
# and could not fire where it could run. That is the same defect this registry
# keeps finding in itself, which is that a gate gets applied to the artifact it
# was written for and to nothing else that discloses, and it is worth saying
# plainly that it was found here by going to install the thing and discovering
# it would refuse every push forever.
#
# This hook asks the questions that mean something in a repository whose job
# is to carry a commitment without carrying what it commits to.
#
# It can be bypassed with --no-verify, deliberately, on the same reasoning as
# the other one: a hook that cannot be overridden is deleted the first time it
# is inconvenient, and what matters is that going around it is a sentence
# somebody typed on purpose.

ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1

PY=python3
command -v python3 >/dev/null 2>&1 || PY=python

if ! $PY suite/hold.py --verify-export >/dev/null 2>&1; then
  $PY suite/hold.py --verify-export
  echo ""
  echo "PUSH REFUSED."
  echo "  This repository is the public one. It may say that records are"
  echo "  held and how many. It may not carry them, and it may not carry a"
  echo "  count that disagrees with what it commits to. Pushing it as it"
  echo "  stands either discloses a finding its subject has not answered or"
  echo "  publishes a register that no longer matches the commitment beside"
  echo "  it."
  echo ""
  echo "  Nothing was pushed. If you have decided this is fine and you know"
  echo "  precisely what becomes public, push again with --no-verify."
  echo ""
  exit 1
fi

# The suite has to pass in the repository a stranger will clone, not only in
# the one it was written in. A registry shipping a broken grader is the whole
# of what it exists to catch, and the export is a copy, so it is the copy that
# gets asked.
if ! $PY suite/selftest.py >/dev/null 2>&1; then
  $PY suite/selftest.py
  echo ""
  echo "PUSH REFUSED."
  echo "  The suite does not pass in this repository. Whatever else is true,"
  echo "  what would be published here is a grader that fails its own cases,"
  echo "  and every verdict it has ever issued is cited against it."
  echo ""
  exit 1
fi

# EVERY OTHER GATE IN THIS REPOSITORY, because until 22 Oct 2026 none of them
# ran here. The hook invoked two commands. README said "It exits nonzero the day
# any fault stops being caught" and "check_readme_pins.py, which exits nonzero
# when it drifts", and both sentences were true of the scripts and false of any
# day: there is no CI in this repository, so a gate nobody invokes is a gate
# that passes on the day someone runs it and never on the day it matters.
#
# check_retracted_claims.py is DELIBERATELY ABSENT from this list. It exits 1 on
# a known, separately-tracked defect that can only be cleared by regenerating
# brand/register.html in the tree that holds the records. A gate that blocks
# every push on a defect you cannot fix here teaches people to pass --no-verify,
# after which none of the gates above work either.
GATES="
suite/check_readme_pins.py
gateway/selftest_gateway.py
gateway/selftest_serve.py
gateway/selftest_observe.py
gateway/selftest_pilot.py
gateway/fault_challenge.py
gateway/inhouse_control.py
examples/wrong_window.py
examples/unknown_outcome.py
examples/decision_demo.py
"

for g in $GATES; do
  [ -f "$g" ] || continue
  if ! $PY "$g" >/dev/null 2>&1; then
    $PY "$g"
    echo ""
    echo "PUSH REFUSED."
    echo "  $g exits nonzero."
    echo ""
    echo "  This is a published claim that no longer holds. Each of these"
    echo "  scripts asserts something this repository states in prose: a"
    echo "  pinned hash, a case count, an indeterminate ceiling, a line-count"
    echo "  bound, a corpus hash, or a worked example's expected output."
    echo "  Pushing now publishes the prose without the property."
    echo ""
    exit 1
  fi
done

# The remaining selftest files. suite/selftest.py is run above; these are the
# other sixteen, and before today none of them ran on a push either.
for g in suite/selftest_*.py gateway/selftest_live.py; do
  [ -f "$g" ] || continue
  if ! $PY "$g" >/dev/null 2>&1; then
    $PY "$g"
    echo ""
    echo "PUSH REFUSED."
    echo "  $g exits nonzero. A selftest that fails in the repository a"
    echo "  stranger clones is the thing this project exists to catch."
    echo ""
    exit 1
  fi
done

# The success line used to read "every selftest, gate and worked example in
# this repository exits 0." That was FALSE, and it printed on every successful
# push from 22 Oct 2026 until it was caught on 23 Oct.
#
# check_retracted_claims.py is a gate in this repository and it exits 1. The
# exclusion above is deliberate and the reasoning for it is sound, but the hook
# then announced a result about a gate it had chosen not to run. That is this
# registry's dominant defect class in the guard that exists to catch it: a
# measurement reporting a result about input it never examined. The exclusion
# was recorded in a comment, where no reader of the output ever sees it.
#
# A skipped check has to appear in the output, not only in the source.
SKIPPED=""
for s in suite/check_retracted_claims.py; do
  [ -f "$s" ] && SKIPPED="$SKIPPED $s"
done

echo "pre-push: nothing held is present, the register agrees with the manifest,"
echo "and every selftest, gate and worked example LISTED IN THIS HOOK exits 0."
if [ -n "$SKIPPED" ]; then
  echo ""
  echo "  NOT RUN, deliberately:$SKIPPED"
  echo "  It exits 1 on a known defect that can only be cleared by"
  echo "  regenerating brand/register.html in the tree holding the records."
  echo "  So this push is NOT a statement that no retracted claim is present."
  echo "  Run it by hand to see that separately-tracked count:"
  echo "      python3 suite/check_retracted_claims.py"
fi
exit 0
